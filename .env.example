# ==============================================================================
# PROSPECTAI - VARIÁVEIS DE AMBIENTE (EXEMPLO)
# O Supabase e o login social com Google podem ser usados no plano gratuito.
# ==============================================================================

# 1. Autenticação oficial (recomendado para cadastro de usuários)
Authentication__Mode=Supabase
Authentication__GoogleEnabled=true
App__BaseUrl=http://localhost:5210
Database__Mode=Local

# 2. Acesso local de desenvolvimento (usado somente com Authentication__Mode=Local)
LocalAuth__Email=seu-email@exemplo.com
LocalAuth__Password=CRIE_UMA_SENHA_FORTE
LocalAuth__Name=Administrador
LocalAuth__UserId=11111111-1111-1111-1111-111111111111

# 3. Supabase Auth. Para usar também o PostgreSQL, altere Database__Mode=Postgres.
ConnectionStrings__DefaultConnection=
Supabase__Url=https://SEU_PROJETO.supabase.co
Supabase__AnonKey=SUA_CHAVE_ANONIMA_AQUI
Supabase__DatabaseUrl=

# 4. Provedores pagos opcionais de prospecção (não são usados no login Google)
GooglePlaces__ApiKey=
Apify__ApiToken=

# 5. Dados demonstrativos (mantenha desativado para uso real)
DemoData__SeedOnStartup=false

# 6. Opcional: diretório persistente para chaves de sessão em hospedagem
DataProtection__KeysPath=
