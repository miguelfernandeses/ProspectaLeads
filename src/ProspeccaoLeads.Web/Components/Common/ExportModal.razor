@using ProspeccaoLeads.Domain.Enums

@if (IsOpen)
{
    <div class="modal-backdrop-custom" @onclick="HandleBackdropClick">
        <div class="modal-dialog-custom" style="max-width: 500px;" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <div style="width: 36px; height: 36px; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.15); display: flex; align-items: center; justify-content: center; color: var(--primary);">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                    <h3 style="font-size: 1.15rem; margin: 0; color: var(--text-primary);">Exportar Leads</h3>
                </div>
                <button type="button" class="btn-icon" @onclick="CloseAsync">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <div class="modal-body-custom">
                <div class="form-group">
                    <label class="form-label">Formato do Arquivo</label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                        <button type="button" 
                                class="card-glass" 
                                style="padding: 16px; cursor: pointer; text-align: left; display: flex; align-items: center; gap: 12px; border-color: @(_selectedFormat == "xlsx" ? "var(--primary)" : "var(--border-color)"); background-color: @(_selectedFormat == "xlsx" ? "rgba(99, 102, 241, 0.1)" : "var(--bg-card)");"
                                @onclick='() => _selectedFormat = "xlsx"'>
                            <div style="font-size: 1.5rem; color: #10B981;">📊</div>
                            <div>
                                <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);">Excel (.xlsx)</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">Formatado com estilos</div>
                            </div>
                        </button>

                        <button type="button" 
                                class="card-glass" 
                                style="padding: 16px; cursor: pointer; text-align: left; display: flex; align-items: center; gap: 12px; border-color: @(_selectedFormat == "csv" ? "var(--primary)" : "var(--border-color)"); background-color: @(_selectedFormat == "csv" ? "rgba(99, 102, 241, 0.1)" : "var(--bg-card)");"
                                @onclick='() => _selectedFormat = "csv"'>
                            <div style="font-size: 1.5rem; color: #3B82F6;">📑</div>
                            <div>
                                <div style="font-weight: 700; font-size: 0.95rem; color: var(--text-primary);">CSV (.csv)</div>
                                <div style="font-size: 0.78rem; color: var(--text-muted);">Compatível com CRMs</div>
                            </div>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Escopo da Exportação</label>
                    <select class="form-control-custom" @bind="_selectedScope">
                        <option value="todos">Todos os leads salvos (@TotalCount leads)</option>
                        <option value="filtrados">Apenas os leads do filtro atual</option>
                        <option value="clientes">Apenas Clientes Conquistados</option>
                        <option value="contatados">Apenas Contatados e em Negociação</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn-modern btn-secondary" @onclick="CloseAsync">Cancelar</button>
                <button type="button" class="btn-modern btn-primary" @onclick="HandleExportAsync">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    Baixar Arquivo
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public EventCallback<(string Format, string Scope)> OnExport { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _selectedFormat = "xlsx";
    private string _selectedScope = "todos";

    private async Task HandleExportAsync()
    {
        await OnExport.InvokeAsync((_selectedFormat, _selectedScope));
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await CloseAsync();
    }
}
