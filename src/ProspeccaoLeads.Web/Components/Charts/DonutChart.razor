@using ProspeccaoLeads.Application.DTOs.Dashboard

<div class="card-glass" style="height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h4 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">@Title</h4>
        <span style="font-size: 0.8rem; color: var(--text-muted);">Total: @Total.ToString("N0")</span>
    </div>

    @if (Items == null || Items.Count == 0 || Total == 0)
    {
        <div style="flex: 1; display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 0.88rem; min-height: 220px;">
            Nenhum dado registrado para exibir
        </div>
    }
    else
    {
        <div style="display: flex; align-items: center; gap: 24px; flex-wrap: wrap; justify-content: center;">
            <div style="position: relative; width: 180px; height: 180px;">
                <svg width="180" height="180" viewBox="0 0 100 100" style="transform: rotate(-90deg);">
                    @{
                        double cumulativePercent = 0;
                        foreach (var item in Items)
                        {
                            var percent = (item.Value / Total) * 100;
                            var dashArray = $"{percent} {100 - percent}";
                            var dashOffset = -cumulativePercent;
                            cumulativePercent += percent;

                            <circle cx="50" cy="50" r="38"
                                    fill="transparent"
                                    stroke="@(item.Color ?? "#6366F1")"
                                    stroke-width="14"
                                    stroke-dasharray="@dashArray"
                                    stroke-dashoffset="@dashOffset"
                                    pathLength="100"
                                    style="transition: stroke-dasharray 0.5s ease;" />
                        }
                    }
                </svg>
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center;">
                    <div style="font-size: 1.4rem; font-weight: 800; font-family: var(--font-heading); color: var(--text-primary);">@Total.ToString("N0")</div>
                    <div style="font-size: 0.72rem; color: var(--text-muted); text-transform: uppercase;">Leads</div>
                </div>
            </div>

            <div style="flex: 1; min-width: 160px; display: flex; flex-direction: column; gap: 8px;">
                @foreach (var item in Items)
                {
                    var percent = Total > 0 ? (item.Value / Total) * 100 : 0;
                    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 0.85rem;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background-color: @(item.Color ?? "#6366F1"); display: inline-block;"></span>
                            <span style="color: var(--text-secondary); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@item.Label</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-weight: 700; color: var(--text-primary);">@item.Value.ToString("N0")</span>
                            <span style="font-size: 0.75rem; color: var(--text-muted); min-width: 38px; text-align: right;">@percent.ToString("0.0")%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Distribuição";
    [Parameter] public List<ChartItemDto> Items { get; set; } = new();

    private double Total => Items?.Sum(i => i.Value) ?? 0;
}
