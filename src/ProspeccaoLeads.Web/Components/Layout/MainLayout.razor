@inherits LayoutComponentBase
@implements IDisposable
@using ProspeccaoLeads.Application.Interfaces
@using ProspeccaoLeads.Web.Components.Common
@inject NavigationManager Navigation
@inject IAuthService AuthService

<div class="app-container">
    <!-- Backdrop de fechar menu no celular -->
    <div class="sidebar-backdrop @(_sidebarOpen ? "active" : "")" @onclick="CloseSidebar"></div>

    <NavMenu IsOpen="_sidebarOpen" OnClose="CloseSidebar" />
    
    <div class="main-wrapper">
        <Header OnToggleSidebar="ToggleSidebar" />
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

<ToastContainer />

@code {
    private bool _sidebarOpen = false;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        var session = await AuthService.GetCurrentUserAsync();
        if (session == null)
        {
            Navigation.NavigateTo("login");
        }
    }

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        _sidebarOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _sidebarOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
