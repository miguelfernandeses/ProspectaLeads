@inherits LayoutComponentBase
@using ProspeccaoLeads.Web.Components.Common

<div style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 50% 10%, rgba(99, 102, 241, 0.15), transparent 70%), var(--bg-main); padding: 24px;">
    <div style="width: 100%; max-width: 440px;">
        <div style="text-align: center; margin-bottom: 28px;">
            <div class="brand-logo" style="margin: 0 auto 16px; width: 48px; height: 48px;">
                <svg width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
            </div>
            <h1 style="font-size: 1.6rem; font-weight: 800; color: var(--text-primary);">ProspectLeads</h1>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 4px;">Sistema Inteligente de Prospecção de Clientes</p>
        </div>

        @Body
    </div>
</div>

<ToastContainer />
