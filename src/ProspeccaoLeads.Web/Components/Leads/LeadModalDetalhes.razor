@using ProspeccaoLeads.Application.DTOs.Lead
@using ProspeccaoLeads.Domain.Enums
@using ProspeccaoLeads.Web.Components.Common
@using ProspeccaoLeads.Web.Services
@inject ToastService ToastService
@inject FileDownloadService FileService

@if (Lead != null && IsOpen)
{
    <div class="modal-backdrop-custom" @onclick="HandleBackdropClick">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="modal-header-custom">
                <div style="display: flex; align-items: center; gap: 14px;">
                    <div style="width: 44px; height: 44px; border-radius: var(--radius-md); background: linear-gradient(135deg, #6366F1, #8B5CF6); display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 1.2rem;">
                        @(string.IsNullOrWhiteSpace(Lead.Nome) ? "L" : Lead.Nome[0].ToString().ToUpper())
                    </div>
                    <div>
                        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                            <h3 style="font-size: 1.25rem; margin: 0; color: var(--text-primary);">@Lead.Nome</h3>
                            <StatusBadge Status="@Lead.Status" />
                        </div>
                        <div style="font-size: 0.82rem; color: var(--text-muted); margin-top: 2px;">
                            @(Lead.Categoria ?? "Sem categoria") • Cadastrado em @Lead.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
                <button type="button" class="btn-icon" @onclick="CloseAsync">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body-custom" style="display: flex; flex-direction: column; gap: 20px;">
                
                <!-- Barra de Ações Rápidas -->
                <div style="display: flex; flex-wrap: wrap; gap: 10px; padding: 14px; background-color: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    @if (!string.IsNullOrWhiteSpace(Lead.WhatsApp) || !string.IsNullOrWhiteSpace(Lead.Telefone))
                    {
                        <a href="@Lead.GetWhatsAppUrl()" target="_blank" class="btn-modern btn-outline-whatsapp btn-sm">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                            </svg>
                            WhatsApp
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Lead.Telefone))
                    {
                        <a href="tel:@Lead.Telefone" class="btn-modern btn-secondary btn-sm">
                            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            Ligar
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Lead.Email))
                    {
                        <a href="mailto:@Lead.Email" class="btn-modern btn-secondary btn-sm">
                            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            E-mail
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Lead.Website))
                    {
                        <a href="@Lead.Website" target="_blank" class="btn-modern btn-secondary btn-sm">
                            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                            </svg>
                            Website
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Lead.Instagram))
                    {
                        <a href="@Lead.GetInstagramUrl()" target="_blank" class="btn-modern btn-secondary btn-sm">
                            <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                            </svg>
                            Instagram
                        </a>
                    }

                    <a href="@Lead.GetGoogleMapsUrl()" target="_blank" class="btn-modern btn-secondary btn-sm">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        Ver Mapa
                    </a>
                </div>

                <!-- Detalhes em Grid -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;">
                    <div style="background: var(--bg-card); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Telefone</div>
                        <div style="font-size: 0.9rem; color: var(--text-primary); margin-top: 4px; font-weight: 600; word-break: break-word;">
                            @(Lead.Telefone ?? Lead.WhatsApp ?? "Não informado")
                        </div>
                    </div>

                    <div style="background: var(--bg-card); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">E-mail</div>
                        <div style="font-size: 0.88rem; color: var(--text-primary); margin-top: 4px; font-weight: 600; word-break: break-all; overflow-wrap: anywhere;">
                            @(Lead.Email ?? "Não informado")
                        </div>
                    </div>

                    <div style="background: var(--bg-card); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Endereço</div>
                        <div style="font-size: 0.9rem; color: var(--text-primary); margin-top: 4px; font-weight: 600; word-break: break-word;">
                            @(Lead.Endereco ?? "Não informado")
                        </div>
                    </div>

                    <div style="background: var(--bg-card); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Cidade / Estado</div>
                        <div style="font-size: 0.9rem; color: var(--text-primary); margin-top: 4px; font-weight: 600; word-break: break-word;">
                            @($"{Lead.Cidade} - {Lead.Estado}")
                        </div>
                    </div>

                    <div style="background: var(--bg-card); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Avaliação</div>
                        <div style="margin-top: 4px;">
                            @if (Lead.Avaliacao.HasValue)
                            {
                                <span class="rating-pill">⭐ @Lead.Avaliacao.Value.ToString("0.0") (@(Lead.QuantidadeAvaliacoes ?? 0) avaliações)</span>
                            }
                            else
                            {
                                <span style="font-size: 0.88rem; color: var(--text-muted);">Sem avaliações</span>
                            }
                        </div>
                    </div>

                    <div style="background: var(--bg-card); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                        <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">Fonte dos Dados</div>
                        <div style="font-size: 0.9rem; color: var(--text-primary); margin-top: 4px; font-weight: 600;">
                            @(Lead.Fonte ?? "Catálogo Comercial")
                        </div>
                    </div>
                </div>

                <!-- Alteração de Status -->
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Alterar Status do Lead</label>
                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                        @foreach (var s in Enum.GetValues<StatusLead>())
                        {
                            <button type="button" 
                                    class="chip-btn @(Lead.Status == s ? "active" : "")"
                                    style="@(Lead.Status == s ? "background-color: var(--primary); color: white; border-color: var(--primary);" : "")"
                                    @onclick="() => HandleStatusChange(s)">
                                @s.ToString()
                            </button>
                        }
                    </div>
                </div>

                <!-- Observações e Notas -->
                <div class="form-group" style="margin-bottom: 0;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label class="form-label" style="margin: 0;">Anotações & Observações da Prospecção</label>
                        <span style="font-size: 0.76rem; color: var(--text-muted);">Histórico de contato e notas internas</span>
                    </div>
                    <textarea class="form-control-custom" 
                              rows="4" 
                              placeholder="Ex.: Ligado em 14/08, falou com Dr. Marcelo. Pediu para enviar proposta pelo WhatsApp na próxima segunda-feira..."
                              @bind="_observacoesTemp"></textarea>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer-custom">
                <button type="button" class="btn-modern btn-secondary" @onclick="CloseAsync">Fechar</button>
                <button type="button" class="btn-modern btn-primary" @onclick="SaveNotesAsync">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Salvar Observações
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public LeadDto? Lead { get; set; }
    [Parameter] public EventCallback<StatusLead> OnStatusChanged { get; set; }
    [Parameter] public EventCallback<string> OnNotesSaved { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _observacoesTemp = string.Empty;

    protected override void OnParametersSet()
    {
        if (Lead != null)
        {
            _observacoesTemp = Lead.Observacoes ?? string.Empty;
        }
    }

    private async Task HandleStatusChange(StatusLead newStatus)
    {
        if (Lead != null && Lead.Status != newStatus)
        {
            Lead.Status = newStatus;
            await OnStatusChanged.InvokeAsync(newStatus);
            ToastService.ShowSuccess($"Status alterado para '{newStatus}'!");
        }
    }

    private async Task SaveNotesAsync()
    {
        await OnNotesSaved.InvokeAsync(_observacoesTemp);
        ToastService.ShowSuccess("Observações atualizadas com sucesso!");
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleBackdropClick()
    {
        await CloseAsync();
    }
}
