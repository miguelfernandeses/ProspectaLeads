@page "/"
@page "/dashboard"
@using ProspeccaoLeads.Application.DTOs.Dashboard
@using ProspeccaoLeads.Application.Interfaces
@using ProspeccaoLeads.Web.Components.Charts
@using ProspeccaoLeads.Web.Components.Common
@using ProspeccaoLeads.Web.Services
@inject IDashboardService DashboardService
@inject ILeadService LeadService
@inject IExportService ExportService
@inject IAuthService AuthService
@inject FileDownloadService FileService
@inject ToastService ToastService
@inject NavigationManager Navigation

<div style="display: flex; flex-direction: column; gap: 28px;">
    
    <!-- Top Header Banner -->
    <div class="card-glass" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.12), rgba(16, 185, 129, 0.05)), var(--bg-surface); padding: 28px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
                <span class="status-badge status-novo" style="font-size: 0.75rem;">Visão Geral do CRM</span>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Atualizado em tempo real</span>
            </div>
            <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--text-primary);">
                Painel de Prospecção & Vendas
            </h1>
            <p style="color: var(--text-secondary); font-size: 0.92rem; margin-top: 4px;">
                Monitore seus potenciais clientes, status de contato e taxas de conversão.
            </p>
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button type="button" class="btn-modern btn-secondary" @onclick="() => _exportModalOpen = true">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                Exportar Dados
            </button>
            <a href="buscar" class="btn-modern btn-primary">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                Prospectar Novos Clientes
            </a>
        </div>
    </div>

    <!-- 6 KPI Metric Cards -->
    <div class="kpi-grid">
        <!-- 1. Encontrados -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-title">Leads Encontrados</span>
                <div class="kpi-icon" style="background-color: rgba(99, 102, 241, 0.15); color: #6366F1;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="kpi-value">@_summary.TotalEncontrados.ToString("N0")</div>
            <div class="kpi-footer">
                <span style="color: var(--info);">📡 Pesquisas acumuladas</span>
            </div>
        </div>

        <!-- 2. Salvos -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-title">Leads Salvos</span>
                <div class="kpi-icon" style="background-color: rgba(59, 130, 246, 0.15); color: #3B82F6;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
                    </svg>
                </div>
            </div>
            <div class="kpi-value">@_summary.TotalSalvos.ToString("N0")</div>
            <div class="kpi-footer">
                <span style="color: var(--success); font-weight: 600;">+@_summary.NovosHoje hoje</span>
            </div>
        </div>

        <!-- 3. Contatados -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-title">Contatados</span>
                <div class="kpi-icon" style="background-color: rgba(245, 158, 11, 0.15); color: #F59E0B;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                </div>
            </div>
            <div class="kpi-value">@_summary.Contatados.ToString("N0")</div>
            <div class="kpi-footer">
                <span>Primeiro contato realizado</span>
            </div>
        </div>

        <!-- 4. Em Negociação -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-title">Em Negociação</span>
                <div class="kpi-icon" style="background-color: rgba(236, 72, 153, 0.15); color: #EC4899;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
            </div>
            <div class="kpi-value">@_summary.EmNegociacao.ToString("N0")</div>
            <div class="kpi-footer">
                <span>Propostas em andamento</span>
            </div>
        </div>

        <!-- 5. Clientes Conquistados -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-title">Clientes Conquistados</span>
                <div class="kpi-icon" style="background-color: rgba(16, 185, 129, 0.15); color: #10B981;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                </div>
            </div>
            <div class="kpi-value" style="color: var(--success);">@_summary.ClientesConquistados.ToString("N0")</div>
            <div class="kpi-footer">
                <span style="color: var(--success);">🎯 Vendas concluídas</span>
            </div>
        </div>

        <!-- 6. Taxa de Conversão -->
        <div class="kpi-card">
            <div class="kpi-header">
                <span class="kpi-title">Taxa de Conversão</span>
                <div class="kpi-icon" style="background-color: rgba(139, 92, 246, 0.15); color: #8B5CF6;">
                    <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                    </svg>
                </div>
            </div>
            <div class="kpi-value" style="color: #A78BFA;">@_summary.TaxaConversao.ToString("0.0")%</div>
            <div class="kpi-footer">
                <span>Clientes ÷ Total Salvos</span>
            </div>
        </div>
    </div>

    <!-- 4 Gráficos do Dashboard -->
    <div class="charts-grid">
        <!-- Gráfico 1: Leads por Nicho -->
        <DonutChart Title="Leads por Nicho / Segmento" Items="@_summary.LeadsPorNicho" />

        <!-- Gráfico 2: Leads por Cidade -->
        <BarChart Title="Top Cidades com Mais Leads" Items="@_summary.LeadsPorCidade" />

        <!-- Gráfico 3: Leads por Status -->
        <DonutChart Title="Distribuição do Funil por Status" Items="@_summary.LeadsPorStatus" />

        <!-- Gráfico 4: Evolução Mensal -->
        <LineChart Title="Evolução Mensal (Leads x Clientes)" Items="@_summary.EvolucaoMensal" />
    </div>

</div>

<!-- Modal de Exportação -->
<ExportModal IsOpen="@_exportModalOpen"
             TotalCount="@_summary.TotalSalvos"
             OnExport="HandleExport"
             OnClose="() => _exportModalOpen = false" />

@code {
    private DashboardSummaryDto _summary = new();
    private Guid _userId;
    private bool _exportModalOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentUserAsync();
        if (session != null)
        {
            _userId = session.UserId;
            await CarregarDashboardAsync();
        }
    }

    private async Task CarregarDashboardAsync()
    {
        _summary = await DashboardService.ObterResumoAsync(_userId);
    }

    private async Task HandleExport((string Format, string Scope) options)
    {
        var leads = await LeadService.ObterTodosAsync(_userId);

        if (options.Scope == "clientes")
        {
            leads = leads.Where(l => l.Status == Domain.Enums.StatusLead.Cliente).ToList();
        }
        else if (options.Scope == "contatados")
        {
            leads = leads.Where(l => l.Status == Domain.Enums.StatusLead.Contatado || l.Status == Domain.Enums.StatusLead.EmNegociacao).ToList();
        }

        if (leads.Count == 0)
        {
            ToastService.ShowWarning("Nenhum lead encontrado para o escopo selecionado.");
            _exportModalOpen = false;
            return;
        }

        byte[] bytes;
        string fileName;
        string contentType;

        if (options.Format == "csv")
        {
            bytes = await ExportService.ExportarParaCsvAsync(leads);
            fileName = $"leads_export_{DateTime.UtcNow:yyyyMMdd_HHmm}.csv";
            contentType = "text/csv;charset=utf-8";
        }
        else
        {
            bytes = await ExportService.ExportarParaExcelAsync(leads);
            fileName = $"leads_export_{DateTime.UtcNow:yyyyMMdd_HHmm}.xlsx";
            contentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
        }

        await FileService.DownloadFileFromBytesAsync(fileName, bytes, contentType);
        ToastService.ShowSuccess($"Arquivo {fileName} gerado com sucesso!");
        _exportModalOpen = false;
    }
}
