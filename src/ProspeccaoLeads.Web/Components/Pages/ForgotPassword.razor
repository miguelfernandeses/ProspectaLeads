@page "/recuperar-senha"
@layout AuthLayout
@using ProspeccaoLeads.Application.DTOs.Auth
@using ProspeccaoLeads.Application.Interfaces
@using ProspeccaoLeads.Web.Services
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

<div class="card-glass" style="padding: 32px;">
    <h2 style="font-size: 1.35rem; margin-bottom: 8px; color: var(--text-primary);">Recuperar Senha</h2>
    <p style="color: var(--text-secondary); font-size: 0.88rem; margin-bottom: 24px;">Informe seu e-mail para receber as instruções de redefinição.</p>

    @if (_sent)
    {
        <div style="background-color: var(--success-bg); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-md); padding: 18px; text-align: center; margin-bottom: 20px;">
            <div style="font-size: 1.8rem; margin-bottom: 8px;">📬</div>
            <div style="font-weight: 700; color: var(--success); margin-bottom: 4px;">Instruções Enviadas!</div>
            <div style="font-size: 0.84rem; color: var(--text-secondary);">Verifique a caixa de entrada do seu e-mail para continuar o processo de redefinição.</div>
        </div>

        <a href="login" class="btn-modern btn-primary" style="width: 100%;">Voltar para o Login</a>
    }
    else
    {
        <EditForm Model="_model" FormName="forgotPasswordForm" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label">E-mail Cadastrado</label>
                <InputText class="form-control-custom" placeholder="seuemail@empresa.com" @bind-Value="_model.Email" />
                <ValidationMessage For="() => _model.Email" style="color: var(--danger); font-size: 0.8rem; margin-top: 4px;" />
            </div>

            <button type="submit" class="btn-modern btn-primary" style="width: 100%; margin-top: 12px;" disabled="@_isLoading">
                @if (_isLoading)
                {
                    <span class="spinner"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar Link de Recuperação</span>
                }
            </button>
        </EditForm>

        <div style="text-align: center; margin-top: 24px; font-size: 0.88rem; color: var(--text-secondary);">
            Lembrou da senha? <a href="login" style="color: var(--primary); font-weight: 600; text-decoration: none;">Voltar para o Login</a>
        </div>
    }
</div>

@code {
    private readonly ResetPasswordDto _model = new();
    private bool _isLoading = false;
    private bool _sent = false;

    private async Task HandleSubmit()
    {
        _isLoading = true;
        try
        {
            var result = await AuthService.ResetPasswordAsync(_model);
            if (result.IsSuccess)
            {
                _sent = true;
                ToastService.ShowSuccess("Se o e-mail estiver cadastrado, as instruções foram enviadas para sua caixa de entrada.");
            }
            else
            {
                ToastService.ShowError(result.ErrorMessage ?? "Falha ao enviar e-mail de recuperação.");
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
