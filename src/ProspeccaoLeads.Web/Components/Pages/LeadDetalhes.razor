@page "/leads/{id:guid}"
@using ProspeccaoLeads.Application.DTOs.Lead
@using ProspeccaoLeads.Application.Interfaces
@using ProspeccaoLeads.Domain.Enums
@using ProspeccaoLeads.Web.Components.Common
@using ProspeccaoLeads.Web.Services
@inject ILeadService LeadService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

@if (_lead == null)
{
    <div class="card-glass" style="text-align: center; padding: 60px;">
        <div class="spinner" style="width: 36px; height: 36px; border-top-color: var(--primary); margin: 0 auto 12px;"></div>
        <div style="color: var(--text-secondary);">Carregando informações do lead...</div>
    </div>
}
else
{
    <div style="display: flex; flex-direction: column; gap: 24px;">
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; align-items: center; gap: 14px;">
                <a href="leads" class="btn-icon" title="Voltar">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </a>
                <div>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin: 0;">@_lead.Nome</h1>
                        <StatusBadge Status="@_lead.Status" />
                    </div>
                    <p style="color: var(--text-secondary); font-size: 0.88rem; margin-top: 2px;">
                        @(_lead.Categoria ?? "Sem categoria") • Cadastrado em @_lead.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>
            </div>

            <div style="display: flex; gap: 10px;">
                @if (!string.IsNullOrWhiteSpace(_lead.WhatsApp) || !string.IsNullOrWhiteSpace(_lead.Telefone))
                {
                    <a href="@_lead.GetWhatsAppUrl()" target="_blank" class="btn-modern btn-outline-whatsapp">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                        </svg>
                        Conversar no WhatsApp
                    </a>
                }
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px;">
            <!-- Coluna Principal -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Card Dados de Contato & Local -->
                <div class="card-glass">
                    <h3 style="font-size: 1.1rem; margin-bottom: 18px; color: var(--text-primary);">Informações do Estabelecimento</h3>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 18px;">
                        <div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Telefone</span>
                            <div style="font-size: 0.95rem; color: var(--text-primary); font-weight: 600; margin-top: 2px;">
                                @(_lead.Telefone ?? "Não informado")
                            </div>
                        </div>

                        <div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">WhatsApp</span>
                            <div style="font-size: 0.95rem; color: var(--text-primary); font-weight: 600; margin-top: 2px;">
                                @(_lead.WhatsApp ?? "Não informado")
                            </div>
                        </div>

                        <div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">E-mail</span>
                            <div style="font-size: 0.95rem; color: var(--text-primary); font-weight: 600; margin-top: 2px;">
                                @(_lead.Email ?? "Não informado")
                            </div>
                        </div>

                        <div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Website</span>
                            <div style="font-size: 0.95rem; color: var(--primary); font-weight: 600; margin-top: 2px;">
                                @if (!string.IsNullOrWhiteSpace(_lead.Website))
                                {
                                    <a href="@_lead.Website" target="_blank" style="color: var(--primary); text-decoration: none;">@_lead.Website</a>
                                }
                                else
                                {
                                    <span style="color: var(--text-muted);">Não informado</span>
                                }
                            </div>
                        </div>

                        <div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Endereço Completo</span>
                            <div style="font-size: 0.95rem; color: var(--text-primary); margin-top: 2px;">
                                @(_lead.Endereco ?? "Não informado")
                            </div>
                        </div>

                        <div>
                            <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Cidade / Estado</span>
                            <div style="font-size: 0.95rem; color: var(--text-primary); font-weight: 600; margin-top: 2px;">
                                @($"{_lead.Cidade} - {_lead.Estado}")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Observações e Notas -->
                <div class="card-glass">
                    <h3 style="font-size: 1.1rem; margin-bottom: 12px; color: var(--text-primary);">Anotações da Prospecção</h3>
                    <textarea class="form-control-custom" rows="6" placeholder="Registre todas as interações com este lead..." @bind="_lead.Observacoes"></textarea>
                    
                    <div style="margin-top: 14px; display: flex; justify-content: flex-end;">
                        <button type="button" class="btn-modern btn-primary" @onclick="SalvarObservacoesAsync">
                            Salvar Anotações
                        </button>
                    </div>
                </div>
            </div>

            <!-- Coluna Lateral -->
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <!-- Status do Funil -->
                <div class="card-glass">
                    <h4 style="font-size: 1rem; margin-bottom: 14px; color: var(--text-primary);">Etapa do Funil</h4>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        @foreach (var s in Enum.GetValues<StatusLead>())
                        {
                            <button type="button" 
                                    class="btn-modern @(_lead.Status == s ? "btn-primary" : "btn-secondary") btn-sm"
                                    style="justify-content: flex-start;"
                                    @onclick="() => AlterarStatusAsync(s)">
                                <span>@s.ToString()</span>
                            </button>
                        }
                    </div>
                </div>

                <!-- Localização no Mapa -->
                <div class="card-glass">
                    <h4 style="font-size: 1rem; margin-bottom: 12px; color: var(--text-primary);">Mapa & Localização</h4>
                    <p style="font-size: 0.84rem; color: var(--text-secondary); margin-bottom: 14px;">
                        Abra diretamente no Google Maps para ver a rota e o entorno do estabelecimento.
                    </p>
                    <a href="@_lead.GetGoogleMapsUrl()" target="_blank" class="btn-modern btn-secondary" style="width: 100%;">
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        Abrir no Google Maps
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private LeadDto? _lead;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentUserAsync();
        if (session != null)
        {
            _userId = session.UserId;
            _lead = await LeadService.ObterPorIdAsync(Id, _userId);
            if (_lead == null)
            {
                ToastService.ShowError("Lead não encontrado.");
                Navigation.NavigateTo("leads");
            }
        }
    }

    private async Task SalvarObservacoesAsync()
    {
        if (_lead != null)
        {
            await LeadService.AtualizarObservacoesAsync(_lead.Id, _lead.Observacoes ?? "", _userId);
            ToastService.ShowSuccess("Observações salvas com sucesso!");
        }
    }

    private async Task AlterarStatusAsync(StatusLead newStatus)
    {
        if (_lead != null && _lead.Status != newStatus)
        {
            _lead.Status = newStatus;
            await LeadService.AtualizarStatusAsync(_lead.Id, newStatus, _userId);
            ToastService.ShowSuccess($"Status atualizado para '{newStatus}'!");
        }
    }
}
