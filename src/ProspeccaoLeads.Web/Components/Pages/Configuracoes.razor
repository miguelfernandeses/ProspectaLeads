@page "/configuracoes"
@using Microsoft.Extensions.Configuration
@using ProspeccaoLeads.Application.DTOs.Auth
@using ProspeccaoLeads.Application.Interfaces
@using ProspeccaoLeads.Web.Services
@inject IAuthService AuthService
@inject CustomAuthenticationStateProvider AuthStateProvider
@inject IConfiguration Configuration
@inject ToastService ToastService
@inject NavigationManager Navigation

<div style="display: flex; flex-direction: column; gap: 24px; max-width: 1100px;">
    <!-- Top Header -->
    <div>
        <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">
            Minha Conta & Preferências
        </h1>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
            Gerencie seus dados pessoais, altere sua senha de acesso e configure suas preferências de prospecção.
        </p>
    </div>

    <!-- Layout em Grid de 2 Colunas -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">

        <!-- 1. Perfil e Dados Pessoais -->
        <div class="card-glass" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                    <h3 style="font-size: 1.15rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                        <svg width="20" height="20" fill="none" stroke="var(--primary)" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        Dados do Perfil
                    </h3>
                    <span class="status-badge status-cliente">Conta Ativa</span>
                </div>

                <!-- Avatar e Resumo -->
                <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px; padding: 16px; background: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    <div class="user-avatar" style="width: 58px; height: 58px; font-size: 1.4rem; font-weight: 800; background: linear-gradient(135deg, var(--primary), var(--secondary)); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.35);">
                        @ObterIniciais(_profileModel.Name)
                    </div>
                    <div>
                        <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-primary);">
                            @(_session?.Name ?? "Usuário")
                        </div>
                        <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;">
                            @(_session?.Email ?? "usuario@exemplo.com")
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 4px;">
                            Plano: <strong>Profissional Pro</strong> • Acesso Ilimitado
                        </div>
                    </div>
                </div>

                <EditForm Model="_profileModel" OnValidSubmit="HandleUpdateProfile">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">Nome Completo / Empresa</label>
                        <InputText class="form-control-custom" placeholder="Seu nome completo" @bind-Value="_profileModel.Name" />
                        <ValidationMessage For="() => _profileModel.Name" style="color: var(--danger); font-size: 0.8rem; margin-top: 4px;" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">E-mail Cadastrado (Acesso)</label>
                        <div style="position: relative;">
                            <input type="text" class="form-control-custom" value="@(_session?.Email ?? "")" disabled style="opacity: 0.75; cursor: not-allowed; background: rgba(0,0,0,0.15);" />
                            <span style="position: absolute; right: 12px; top: 10px; font-size: 0.75rem; color: var(--text-muted);">🔒 Fixo</span>
                        </div>
                        <span style="font-size: 0.76rem; color: var(--text-muted); margin-top: 4px; display: block;">
                            O e-mail é o identificador único da sua conta no sistema.
                        </span>
                    </div>

                    <button type="submit" class="btn-modern btn-primary" style="width: 100%; margin-top: 8px;" disabled="@_isSavingProfile">
                        @if (_isSavingProfile)
                        {
                            <span class="spinner"></span>
                            <span>Salvando...</span>
                        }
                        else
                        {
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>Salvar Dados do Perfil</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>

        <!-- 2. Segurança e Alteração de Senha -->
        <div class="card-glass" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
                    <h3 style="font-size: 1.15rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                        <svg width="20" height="20" fill="none" stroke="var(--warning)" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                        Alterar Senha de Acesso
                    </h3>
                    <span class="status-badge status-emnegociacao">Segurança</span>
                </div>

                <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 20px;">
                    Para sua proteção, utilize uma senha forte com no mínimo 6 caracteres, combinando letras e números.
                </p>

                <EditForm Model="_passwordModel" OnValidSubmit="HandleChangePassword">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="form-label">Nova Senha</label>
                        <InputText type="password" class="form-control-custom" placeholder="••••••••" @bind-Value="_passwordModel.NewPassword" />
                        <ValidationMessage For="() => _passwordModel.NewPassword" style="color: var(--danger); font-size: 0.8rem; margin-top: 4px;" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirmar Nova Senha</label>
                        <InputText type="password" class="form-control-custom" placeholder="••••••••" @bind-Value="_passwordModel.ConfirmNewPassword" />
                        <ValidationMessage For="() => _passwordModel.ConfirmNewPassword" style="color: var(--danger); font-size: 0.8rem; margin-top: 4px;" />
                    </div>

                    <div style="background: rgba(99, 102, 241, 0.08); padding: 12px; border-radius: var(--radius-md); border: 1px solid rgba(99, 102, 241, 0.2); margin-bottom: 16px; font-size: 0.8rem; color: var(--text-secondary);">
                        💡 <strong>Dica de Segurança:</strong> Ao alterar sua senha, sua sessão atual permanecerá ativa neste navegador com segurança.
                    </div>

                    <button type="submit" class="btn-modern btn-secondary" style="width: 100%; font-weight: 700;" disabled="@_isSavingPassword">
                        @if (_isSavingPassword)
                        {
                            <span class="spinner"></span>
                            <span>Atualizando senha...</span>
                        }
                        else
                        {
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                            </svg>
                            <span>Atualizar Senha</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>
    </div>

    <!-- 3. Preferências de Prospecção Padrão -->
    <div class="card-glass">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" fill="none" stroke="var(--primary)" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
                    </svg>
                    Preferências de Prospecção Padrão
                </h3>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 4px;">
                    Configure filtros padrão para agilizar suas pesquisas diárias de estabelecimentos.
                </p>
            </div>
            <button type="button" class="btn-modern btn-primary btn-sm" @onclick="HandleSavePreferences">
                <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Salvar Preferências
            </button>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.82rem;">Nicho / Segmento Favorito</label>
                <input type="text" class="form-control-custom" placeholder="Ex: Hamburguerias, Clínicas..." @bind="_defaultNiche" />
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.82rem;">Cidade Padrão</label>
                <input type="text" class="form-control-custom" placeholder="Ex: Santos, Campinas..." @bind="_defaultCity" />
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.82rem;">Estado (UF) Padrão</label>
                <select class="form-control-custom" @bind="_defaultState">
                    <option value="SP">São Paulo (SP)</option>
                    <option value="RJ">Rio de Janeiro (RJ)</option>
                    <option value="MG">Minas Gerais (MG)</option>
                    <option value="RS">Rio Grande do Sul (RS)</option>
                    <option value="PR">Paraná (PR)</option>
                    <option value="SC">Santa Catarina (SC)</option>
                    <option value="BA">Bahia (BA)</option>
                    <option value="GO">Goiás (GO)</option>
                    <option value="PE">Pernambuco (PE)</option>
                    <option value="CE">Ceará (CE)</option>
                    <option value="DF">Distrito Federal (DF)</option>
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label" style="font-size: 0.82rem;">Raio de Busca Sugerido</label>
                <select class="form-control-custom" @bind="_defaultRadius">
                    <option value="5">5 km (Bairro / Região Central)</option>
                    <option value="15">15 km (Cidade Inteira)</option>
                    <option value="30">30 km (Região Metropolitana)</option>
                    <option value="50">50 km (Macrorregião)</option>
                </select>
            </div>
        </div>
    </div>

    <!-- 4. Integração Google Maps & Web Scraping (Apify) -->
    <div class="card-glass" style="border-color: rgba(99, 102, 241, 0.35);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
            <div>
                <h3 style="font-size: 1.15rem; color: var(--text-primary); margin: 0; display: flex; align-items: center; gap: 8px;">
                    <svg width="20" height="20" fill="none" stroke="var(--primary)" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    Google Maps Real em Tempo Real (via Apify Scraper)
                </h3>
                <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 4px;">
                    Conecte o Apify para extrair dados 100% reais diretamente do Google Maps (com telefones, endereços e redes sociais).
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(_apifyToken) && !_apifyToken.Contains("SEU_TOKEN"))
            {
                <span class="status-badge status-cliente" style="display: flex; align-items: center; gap: 6px;">
                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--success);"></span>
                    Conectado ao Google Maps
                </span>
            }
            else
            {
                <span class="status-badge" style="background: rgba(255,255,255,0.08); color: var(--text-muted);">
                    Não configurado (Usando Catálogo Interno)
                </span>
            }
        </div>

        <div style="background: rgba(99, 102, 241, 0.06); border-radius: var(--radius-md); padding: 14px; border: 1px solid rgba(99, 102, 241, 0.15); margin-bottom: 18px; font-size: 0.82rem; color: var(--text-secondary); line-height: 1.5;">
            ✨ <strong>Como funciona o Apify?</strong> O Apify oferece <strong>$5 dólares gratuitos todo mês</strong> no plano gratuito (~2.000 buscas reais sem pagar nada).
            <div style="margin-top: 6px;">
                1. Crie sua conta gratuita em <a href="https://console.apify.com/sign-up" target="_blank" style="color: var(--primary); text-decoration: underline; font-weight: 600;">console.apify.com</a>.<br />
                2. Copie seu <strong>API Token</strong> em <em>Settings &gt; Integrations &gt; API Tokens</em> e cole abaixo.
            </div>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
            <label class="form-label" style="display: flex; justify-content: space-between; align-items: center;">
                <span>Apify Personal API Token</span>
                <a href="https://console.apify.com/account/integrations" target="_blank" style="font-size: 0.78rem; color: var(--primary); text-decoration: none;">
                    Obter Token no Apify ↗
                </a>
            </label>
            <div style="position: relative;">
                <input type="@(_mostrarApifyToken ? "text" : "password")" 
                       class="form-control-custom" 
                       placeholder="apify_api_xxxxxxxxxxxxxxxxxxxxxxxxx" 
                       @bind="_apifyToken" 
                       style="padding-right: 44px; font-family: monospace;" />
                <button type="button" 
                        @onclick="() => _mostrarApifyToken = !_mostrarApifyToken"
                        style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px;">
                    @if (_mostrarApifyToken)
                    {
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"></path>
                        </svg>
                    }
                    else
                    {
                        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                        </svg>
                    }
                </button>
            </div>
        </div>

        <button type="button" class="btn-modern btn-primary" style="font-weight: 700;" @onclick="HandleSaveApifyToken">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Salvar Chave do Apify</span>
        </button>
    </div>

    <!-- 5. Sessão & Logout -->
    <div class="card-glass" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; border-color: rgba(239, 68, 68, 0.25);">
        <div>
            <h3 style="font-size: 1.05rem; color: var(--text-primary); margin: 0;">Sessão da Conta</h3>
            <p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 2px;">
                Deseja desconectar este dispositivo do sistema ProspectAI?
            </p>
        </div>

        <button type="button" class="btn-modern btn-secondary" style="color: var(--danger); border-color: rgba(239, 68, 68, 0.4);" @onclick="HandleLogout">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            <span>Encerrar Sessão (Sair)</span>
        </button>
    </div>
</div>

@code {
    private UserSessionDto? _session;
    private UpdateProfileDto _profileModel = new();
    private ChangePasswordDto _passwordModel = new();

    private string _defaultNiche = "Restaurantes";
    private string _defaultCity = "São Paulo";
    private string _defaultState = "SP";
    private string _defaultRadius = "15";

    private string _apifyToken = string.Empty;
    private bool _mostrarApifyToken = false;

    private bool _isSavingProfile = false;
    private bool _isSavingPassword = false;

    protected override async Task OnInitializedAsync()
    {
        _session = await AuthService.GetCurrentUserAsync();
        if (_session == null)
        {
            Navigation.NavigateTo("login");
            return;
        }

        _profileModel.Name = _session.Name;

        _apifyToken = Configuration["Apify:ApiToken"] ?? 
                      Environment.GetEnvironmentVariable("APIFY_API_TOKEN") ?? 
                      Environment.GetEnvironmentVariable("Apify__ApiToken") ?? 
                      "";
    }

    private void HandleSaveApifyToken()
    {
        var token = _apifyToken?.Trim() ?? "";
        Environment.SetEnvironmentVariable("APIFY_API_TOKEN", token);
        Configuration["Apify:ApiToken"] = token;

        if (!string.IsNullOrWhiteSpace(token))
        {
            ToastService.ShowSuccess("Chave do Apify (Google Maps) configurada com sucesso!");
        }
        else
        {
            ToastService.ShowInfo("Chave do Apify removida. O sistema usará o catálogo e provedores padrão.");
        }
    }

    private string ObterIniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "PL";
        var parts = nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private async Task HandleUpdateProfile()
    {
        _isSavingProfile = true;
        try
        {
            var result = await AuthService.UpdateProfileAsync(_profileModel);
            if (result.IsSuccess && result.Value != null)
            {
                _session = result.Value;
                AuthStateProvider.NotifyUserAuthentication(result.Value);
                ToastService.ShowSuccess("Dados do perfil atualizados com sucesso!");
            }
            else
            {
                ToastService.ShowError(result.ErrorMessage ?? "Erro ao atualizar perfil.");
            }
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private async Task HandleChangePassword()
    {
        _isSavingPassword = true;
        try
        {
            var result = await AuthService.ChangePasswordAsync(_passwordModel);
            if (result.IsSuccess)
            {
                _passwordModel = new ChangePasswordDto();
                ToastService.ShowSuccess("Senha de acesso atualizada com sucesso!");
            }
            else
            {
                ToastService.ShowError(result.ErrorMessage ?? "Erro ao alterar a senha.");
            }
        }
        finally
        {
            _isSavingPassword = false;
        }
    }

    private void HandleSavePreferences()
    {
        ToastService.ShowSuccess("Preferências de prospecção salvas com sucesso!");
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        AuthStateProvider.NotifyUserLogout();
        ToastService.ShowSuccess("Você encerrou sua sessão com sucesso.");
        Navigation.NavigateTo("login");
    }
}
