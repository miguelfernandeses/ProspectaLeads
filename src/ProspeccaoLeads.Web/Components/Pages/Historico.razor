@page "/historico"
@using ProspeccaoLeads.Application.DTOs.SearchHistory
@using ProspeccaoLeads.Application.Interfaces
@using ProspeccaoLeads.Web.Components.Common
@using ProspeccaoLeads.Web.Services
@inject ISearchHistoryService HistoryService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

<div style="display: flex; flex-direction: column; gap: 24px;">
    <!-- Top Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <div>
            <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary);">
                Histórico de Pesquisas
            </h1>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 4px;">
                Veja todas as buscas realizadas anteriormente e repita pesquisas com 1 clique.
            </p>
        </div>

        @if (_historico.Count > 0)
        {
            <button type="button" class="btn-modern btn-outline-danger btn-sm" @onclick="() => _confirmClearOpen = true">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                </svg>
                Limpar Todo o Histórico
            </button>
        }
    </div>

    <!-- Lista de Histórico -->
    @if (_isLoading)
    {
        <div class="card-glass" style="text-align: center; padding: 60px;">
            <div class="spinner" style="width: 36px; height: 36px; border-top-color: var(--primary); margin: 0 auto 12px;"></div>
            <div style="color: var(--text-secondary);">Carregando histórico...</div>
        </div>
    }
    else if (_historico.Count == 0)
    {
        <div class="card-glass" style="text-align: center; padding: 60px 20px;">
            <div style="font-size: 2.2rem; margin-bottom: 12px;">📜</div>
            <h3 style="font-size: 1.2rem; color: var(--text-primary);">Nenhuma pesquisa registrada</h3>
            <p style="color: var(--text-secondary); font-size: 0.88rem; max-width: 420px; margin: 6px auto 20px;">
                Suas pesquisas por estabelecimentos serão gravadas aqui automaticamente para que você possa revisitá-las.
            </p>
            <a href="buscar" class="btn-modern btn-primary">
                Fazer Primeira Pesquisa
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-modern">
                <thead>
                    <tr>
                        <th>Nicho / Ramo</th>
                        <th>Localização</th>
                        <th>Resultados</th>
                        <th>Data da Pesquisa</th>
                        <th style="text-align: right;">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _historico)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 700; color: var(--text-primary); font-size: 0.95rem;">@item.Niche</div>
                            </td>
                            <td>
                                <div style="font-size: 0.88rem; color: var(--text-secondary); display: flex; align-items: center; gap: 4px;">
                                    <span>📍</span> @item.Location
                                </div>
                            </td>
                            <td>
                                <span class="status-badge status-novo">@item.ResultCount resultados</span>
                            </td>
                            <td>
                                <div style="font-size: 0.82rem; color: var(--text-muted);">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            </td>
                            <td style="text-align: right;">
                                <div style="display: inline-flex; align-items: center; gap: 8px;">
                                    <button type="button" class="btn-modern btn-primary btn-sm" @onclick="() => PesquisarNovamente(item)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                        </svg>
                                        PESQUISAR NOVAMENTE
                                    </button>

                                    <button type="button" class="btn-icon" style="color: var(--danger);" title="Excluir item" @onclick="() => ExcluirItemAsync(item.Id)">
                                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Confirmação Limpar Histórico -->
<ConfirmModal IsOpen="@_confirmClearOpen"
              Title="Limpar Histórico de Pesquisas"
              Message="Tem certeza que deseja apagar todo o histórico de pesquisas? Essa ação não pode ser desfeita."
              ConfirmText="Limpar Histórico"
              IsDanger="true"
              OnResult="ConfirmarLimpezaAsync" />

@code {
    private IReadOnlyList<SearchHistoryDto> _historico = Array.Empty<SearchHistoryDto>();
    private bool _isLoading = true;
    private Guid _userId;
    private bool _confirmClearOpen = false;

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetCurrentUserAsync();
        if (session != null)
        {
            _userId = session.UserId;
            await CarregarHistoricoAsync();
        }
    }

    private async Task CarregarHistoricoAsync()
    {
        _isLoading = true;
        try
        {
            _historico = await HistoryService.ObterHistoricoAsync(_userId, 100);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void PesquisarNovamente(SearchHistoryDto item)
    {
        var url = $"buscar?nicho={Uri.EscapeDataString(item.Niche)}&local={Uri.EscapeDataString(item.Location)}";
        Navigation.NavigateTo(url);
    }

    private async Task ExcluirItemAsync(Guid id)
    {
        await HistoryService.ExcluirAsync(id, _userId);
        ToastService.ShowSuccess("Item removido do histórico.");
        await CarregarHistoricoAsync();
    }

    private async Task ConfirmarLimpezaAsync(bool confirmed)
    {
        _confirmClearOpen = false;
        if (confirmed)
        {
            await HistoryService.LimparHistoricoAsync(_userId);
            ToastService.ShowSuccess("Histórico limpo com sucesso.");
            await CarregarHistoricoAsync();
        }
    }
}
